# Port backend (prefix /api/v1)
PORT=3000

# Driver integrasi eksternal - lihat bagian "Kontrak integrasi" di PLAN.md.
# Default lokal memakai fake/inmemory agar tidak butuh kredensial pihak ketiga.
PAYMENT_DRIVER=fake
SEARCH_DRIVER=memory
OBJECT_STORAGE_DRIVER=minio
MESSAGE_DRIVER=inmemory

# Midtrans sandbox - isi saat Fase 2, jangan di-commit nilai aslinya.
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_PRODUCTION=false
